<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFDF9"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="#C8BFAF" />
        <TextView android:id="@+id/reader_sheet_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ajustes de lectura" android:textColor="#2B2620" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Tema" android:textColor="#7A7166" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/sheet_theme_light" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Claro" />
            <Button android:id="@+id/sheet_theme_dark" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Noche" />
            <Button android:id="@+id/sheet_theme_violet" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Violeta" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tipografía" android:textColor="#7A7166" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/sheet_font_sans" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Sans" />
            <Button android:id="@+id/sheet_font_serif" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Serif" />
            <Button android:id="@+id/sheet_font_mono" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Mono" />
        </LinearLayout>

        <TextView android:id="@+id/sheet_size_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tamaño" android:textColor="#7A7166" />
        <SeekBar android:id="@+id/sheet_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView android:id="@+id/sheet_spacing_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interlineado" android:textColor="#7A7166" />
        <SeekBar android:id="@+id/sheet_spacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <Button android:id="@+id/sheet_scroll" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Desplazamiento" />
            <Button android:id="@+id/sheet_pages" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Páginas" />
        </LinearLayout>
        <Button android:id="@+id/sheet_orientation" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:text="Orientación" />
    </LinearLayout>
</ScrollView>
