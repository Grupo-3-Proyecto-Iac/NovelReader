<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14181A">

    <LinearLayout
        android:id="@+id/reader_content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/reader_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F014181A"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/reader_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Volver a la biblioteca"
                android:minWidth="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@null" />

            <TextView
                android:id="@+id/reader_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="NovelReader"
                android:textColor="#F1EFE8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/reader_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Buscar en la novela"
                android:minWidth="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                android:tint="@null" />

            <ImageButton
                android:id="@+id/bookmark_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Guardar párrafo"
                android:minWidth="44dp"
                android:padding="0dp"
                android:src="@drawable/ic_bookmark_outline"
                android:scaleType="center"
                android:tint="@null" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/reader_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/reader_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/reader_mini_player_bg"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/reader_audio"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@android:color/transparent"
                android:contentDescription="Reproducir audio"
                android:minWidth="58dp"
                android:padding="16dp"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:tint="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">
                <TextView
                    android:id="@+id/reader_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Voz M5 · 1.40×"
                    android:textColor="#F1EFE8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/reader_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="9dp"
                    android:max="100"
                    android:progressTint="#E0B36A"
                    android:progressBackgroundTint="#384145" />
            </LinearLayout>

            <Button
                android:id="@+id/reader_settings"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="#14181A"
                android:contentDescription="Abrir ajustes de lectura"
                android:minWidth="54dp"
                android:padding="0dp"
                android:text="Aa"
                android:textColor="#A4AEB0"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/reader_scroll_indicator"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="102dp"
        android:alpha="0"
        android:background="@drawable/reader_scroll_track"
        android:visibility="invisible">

        <View
            android:id="@+id/reader_scroll_thumb"
            android:layout_width="5dp"
            android:layout_height="48dp"
            android:background="@drawable/reader_scroll_thumb" />
    </FrameLayout>

    <!-- Anclajes invisibles conservados para la lógica existente. -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <TextView android:id="@+id/reader_progress_label" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/toc_button" android:layout_width="1dp" android:layout_height="1dp" />
        <Button android:id="@+id/reader_bookmarks" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</FrameLayout>
