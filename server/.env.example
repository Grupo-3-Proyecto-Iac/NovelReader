PORT=10000

# Déjalo vacío para pruebas locales. En producción usa un secreto largo.
TTS_AUTH_TOKEN=
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_VOICE=M5
SUPERTONIC_STEPS=8
MAX_TTS_CONCURRENCY=1
MAX_PENDING_SEGMENTS=3

# Ajusta estos valores según los vCPU disponibles en el servidor.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
ORT_INTRA_OP_NUM_THREADS=4
ORT_INTER_OP_NUM_THREADS=1
LOG_LEVEL=INFO
